          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/tutor/summaries/ley-39?oposicion=aux-adm-estado",
              "host": ["{{base_url}}"],
              "path": ["tutor", "summaries", "ley-39"],
              "query": [{ "key": "oposicion", "value": "aux-adm-estado" }]
            }
