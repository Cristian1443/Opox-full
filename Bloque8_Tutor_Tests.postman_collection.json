          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/tutor/summaries/tema-inexistente?oposicion=aux-adm-estado",
              "host": ["{{base_url}}"],
              "path": ["tutor", "summaries", "tema-inexistente"],
              "query": [{ "key": "oposicion", "value": "aux-adm-estado" }]
            },
            "description": "Cuando el topicId no existe en BD, devuelve 404. Esto es lo esperado hasta que la IA genere y cachee el resumen."
          }
        }
      ]
    }
  ]
}
