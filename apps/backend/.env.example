# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS: orígenes permitidos separados por coma.
# En dev incluye la URL del bundler de Expo si consumes desde web.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ─────────────────────────────────────────────
# Supabase (crea el proyecto en https://supabase.com)
# ─────────────────────────────────────────────
# TODO: rellenar tras crear el proyecto en Supabase
#   1. Crear proyecto nuevo en https://app.supabase.com/
#   2. Project Settings → API → copiar Project URL y anon key
#   3. Project Settings → API → copiar service_role key (SOLO backend, nunca al mobile)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# API cliente (fuente de datos oficiales, temarios, BOE)
# ─────────────────────────────────────────────
# TODO: contratos por definir con el cliente
CLIENT_API_BASE_URL=
CLIENT_API_KEY=
CLIENT_API_TIMEOUT_MS=15000

# ─────────────────────────────────────────────
# API de IA — OpenAI directo (Bloques 6 y 7)
# ─────────────────────────────────────────────
# Cliente OpenAI para generateQuestions / analyzePhoto / generateSurgicalTest
# / generateHint. Si estas tres primeras vars están rellenas, container.ts
# usa AiApiClient real; si no, cae a AiApiClientStub con datos mock.
#
# analyzePhoto FUERZA gpt-4o (visión); las otras 3 usan AI_API_DEFAULT_MODEL.
# Recomendado: gpt-4o-mini por coste (~$0.008 por test de 25 preguntas).
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_API_DEFAULT_MODEL=gpt-4o-mini
AI_API_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
# Motor de IA del cliente (RAG + evidencia verbatim)
# ─────────────────────────────────────────────
# Servicio HTTP separado que ingesta PDFs de temario y genera tests con
# cita literal + página. Documentación: MotorIA_Ingesta_Tests.postman_collection.json
# Estado 2026-07-25: NO desplegado, sólo lo tienen el equipo IA en local.
# Rellenar cuando publiquen URL y activar en container.ts.
# Ver packages/ai/MOTOR_INTEGRATION.md.
MOTOR_API_BASE_URL=
MOTOR_API_KEY=
MOTOR_API_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
# RevenueCat (webhook de pagos y suscripciones)
# ─────────────────────────────────────────────
# TODO: crear cuenta en https://www.revenuecat.com/ y configurar webhook
REVENUECAT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Expo Push (notificaciones)
# ─────────────────────────────────────────────
# https://docs.expo.dev/push-notifications/sending-notifications/
EXPO_ACCESS_TOKEN=
