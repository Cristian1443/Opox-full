                  "    pm.expect(p.id).to.equal(pm.collectionVariables.get('product_id'));",
                  "    pm.expect(p.conditions).to.be.an('array');",
                  "    pm.expect(p.expiry).to.be.a('string');",
                  "});"
                ],
