          "name": "Listar todos los productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('ok = true', () => pm.expect(res.ok).to.be.true);",
                  "pm.test('data es array', () => pm.expect(res.data).to.be.an('array'));",
                  "pm.test('al menos 3 productos del seed', () => pm.expect(res.data.length).to.be.at.least(3));",
                  "if (res.data.length > 0) {",
                  "    const p = res.data[0];",
                  "    pm.test('shape StoreProductDTO', () => {",
                  "        pm.expect(p).to.include.keys('id','partner','title','cost','stock','isAvailable','conditions');",
                  "        pm.expect(p.cost).to.be.a('number').and.above(0);",
                  "        pm.expect(p.conditions).to.be.an('array');",
                  "    });",
                  "    const available = res.data.find(x => x.isAvailable && x.category !== 'Test');",
                  "    if (available) {",
                  "        pm.collectionVariables.set('product_id', available.id);",
                  "        console.log('✅ product_id fijado:', available.id, '|', available.partner, available.title);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
