        {
          "name": "GET /boe/changes/:id/comparison — antes y después",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('ok = true', () => pm.expect(res.ok).to.be.true);",
                  "const d = res.data;",
                  "pm.test('shape BoeComparisonResponse', () => {",
                  "    pm.expect(d).to.include.keys('articulo', 'regulationTitle', 'boeIdentifier', 'hint', 'blocks');",
                  "});",
                  "pm.test('blocks[] tiene 2 elementos', () => pm.expect(d.blocks).to.have.lengthOf(2));",
                  "const antes = d.blocks.find(b => b.type === 'antes');",
                  "const despues = d.blocks.find(b => b.type === 'despues');",
                  "pm.test('existe bloque antes', () => pm.expect(antes).to.not.be.undefined);",
                  "pm.test('existe bloque despues', () => pm.expect(despues).to.not.be.undefined);",
                  "pm.test('antes tiene segments[]', () => pm.expect(antes.segments).to.be.an('array').and.not.empty);",
                  "pm.test('despues tiene segments[]', () => pm.expect(despues.segments).to.be.an('array').and.not.empty);",
                  "pm.test('segmento tiene type y text', () => {",
                  "    const s = antes.segments[0];",
                  "    pm.expect(s).to.include.keys('type', 'text');",
                  "    pm.expect(['normal','deleted','added']).to.include(s.type);",
                  "});",
                  "pm.test('hay segmento deleted en antes (diff funciona)', () => {",
                  "    pm.expect(antes.segments.some(s => s.type === 'deleted')).to.be.true;",
                  "});",
                  "pm.test('hay segmento added en despues (diff funciona)', () => {",
                  "    pm.expect(despues.segments.some(s => s.type === 'added')).to.be.true;",
                  "});",
                  "console.log('antes segments:', antes.segments.length, '| deleted:', antes.segments.filter(s=>s.type==='deleted').length);",
                  "console.log('despues segments:', despues.segments.length, '| added:', despues.segments.filter(s=>s.type==='added').length);"
                ],
                "type": "text/javascript"
              }
            }
          ],
